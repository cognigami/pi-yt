{
  "name": "pi-yt",
  "version": "0.1.0",
  "description": "Pi extension package exposing narrow yt-dlp transcript tools.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "yt-dlp",
    "transcripts"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "pi-extension-kit": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "pi-extension-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "bun-types": "^1.3.14",
    "pi-extension-kit": "file:../pi-extension-kit",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2"
  },
  "piYt": {
    "externalDependencies": [
      "yt-dlp"
    ],
    "operatorContracts": {
      "yt_transcript": {
        "kind": "runtime-tool",
        "dependsOn": [
          "yt-dlp"
        ]
      }
    }
  }
}
